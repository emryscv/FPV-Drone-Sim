<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="FCMenu" src="project://database/Assets/UI/SettingsMenus/FCMenu.uxml?fileID=9197481963319205126&amp;guid=8a85aa47e1c774a47b24e333d6de7620&amp;type=3#FCMenu"/>
