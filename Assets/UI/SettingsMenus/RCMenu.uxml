<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SettingsMenus/rc-menu.uss?fileID=7433441132597879392&amp;guid=163ae17348a13384dae93b6509f82ca2&amp;type=3#rc-menu"/>
    <ui:VisualElement name="Content" style="flex-grow: 1; flex-direction: column; position: relative; align-self: stretch; align-items: center; justify-content: center; display: flex;">
        <ui:VisualElement name="Controller" style="flex-grow: 0; justify-content: center; align-items: center; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(244, 244, 244, 0.08); border-right-color: rgba(244, 244, 244, 0.08); border-top-color: rgba(244, 244, 244, 0.08); border-bottom-color: rgba(244, 244, 244, 0.08); background-image: url(&quot;project://database/Assets/Images/Textures/ControllerBG.svg?fileID=7388822144124034973&amp;guid=32bd9d099f138f146b8e6dced057ded4&amp;type=3#ControllerBG&quot;); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; flex-direction: column; background-size: 100% 100%; display: flex;">
            <ui:VisualElement name="Status" style="flex-grow: 0; flex-direction: row; align-items: center; align-self: flex-start; margin-bottom: 20px; align-content: center; justify-content: flex-start;">
                <ui:Image source="project://database/Assets/Images/Icons/no_gamepad.svg?fileID=7388822144124034973&amp;guid=0394ae6d090ba1c4a9b842e372f21ff5&amp;type=3#no_gamepad" tint-color="rgb(103, 26, 22)" name="StatusIcon" style="height: 20px; width: 20px; margin-right: 6px;"/>
                <ui:Label text="NO CONTROLLER DETECTED" name="StatusLabel" style="color: rgb(103, 26, 22); -unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Gimbals" style="flex-grow: 0; flex-direction: row;">
                <ui:VisualElement name="LeftColumn" style="flex-grow: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: center;">
                    <ui:VisualElement name="Gimbal" style="flex-grow: 0; width: 130px; height: 130px; background-image: url(&quot;project://database/Assets/Images/Textures/GimbalBG.svg?fileID=7388822144124034973&amp;guid=66ae6d20430e5ab4b984f61b03f662c4&amp;type=3#GimbalBG&quot;); background-color: rgb(8, 12, 16); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-color: rgba(244, 244, 244, 0.35); border-right-color: rgba(244, 244, 244, 0.35); border-top-color: rgba(244, 244, 244, 0.35); border-bottom-color: rgba(244, 244, 244, 0.35); top: 0;">
                        <ui:VisualElement name="LeftStick" style="flex-grow: 0; height: 20px; width: 20px; background-image: url(&quot;project://database/Assets/Images/Textures/Stick.svg?fileID=7388822144124034973&amp;guid=af6cc0eb15598d7489ad43eaeceacb63&amp;type=3#Stick&quot;); top: 50%; left: 50%; position: absolute; right: auto; bottom: auto; -unity-text-align: upper-left; transform-origin: left top; translate: -50% -50%; transition-timing-function: ease;"/>
                    </ui:VisualElement>
                    <ui:Label text="THROTTLE / YAW" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Medium.ttf?fileID=12800000&amp;guid=4502073703758934880cc373e6200123&amp;type=3#BarlowCondensed-Medium&quot;); font-size: 11px; -unity-text-align: upper-center; letter-spacing: 10px; color: rgba(244, 244, 244, 0.35);"/>
                </ui:VisualElement>
                <ui:VisualElement name="CenterColumn" style="flex-grow: 1; align-self: center; justify-content: flex-start; align-items: stretch; padding-left: 150px; padding-right: 150px;">
                    <ui:Image name="Image" source="project://database/Assets/Images/DroneIcon.svg?fileID=7388822144124034973&amp;guid=dfed4a4b8c715994bbddcac32dfe34f3&amp;type=3#DroneIcon" tint-color="rgb(76, 171, 54)" style="width: 36px; height: 36px; margin-bottom: 12px;"/>
                    <ui:Image source="project://database/Assets/Images/Textures/ControllerButtons.svg?fileID=7388822144124034973&amp;guid=99461f2cf52c6fa41ae397823eef46fe&amp;type=3#ControllerButtons"/>
                </ui:VisualElement>
                <ui:VisualElement name="RightColumn" style="flex-grow: 0; margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0;">
                    <ui:VisualElement name="Gimbal" style="flex-grow: 0; width: 130px; height: 130px; background-image: url(&quot;project://database/Assets/Images/Textures/GimbalBG.svg?fileID=7388822144124034973&amp;guid=66ae6d20430e5ab4b984f61b03f662c4&amp;type=3#GimbalBG&quot;); background-color: rgb(8, 12, 16); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-color: rgba(244, 244, 244, 0.35); border-right-color: rgba(244, 244, 244, 0.35); border-top-color: rgba(244, 244, 244, 0.35); border-bottom-color: rgba(244, 244, 244, 0.35);">
                        <ui:VisualElement name="RightStick" style="flex-grow: 0; height: 20px; width: 20px; background-image: url(&quot;project://database/Assets/Images/Textures/Stick.svg?fileID=7388822144124034973&amp;guid=af6cc0eb15598d7489ad43eaeceacb63&amp;type=3#Stick&quot;); top: 50%; left: 50%; position: absolute; translate: -50% -50%;"/>
                    </ui:VisualElement>
                    <ui:Label text="PITCH / ROLL" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Medium.ttf?fileID=12800000&amp;guid=4502073703758934880cc373e6200123&amp;type=3#BarlowCondensed-Medium&quot;); font-size: 11px; -unity-text-align: upper-center; letter-spacing: 10px; color: rgba(244, 244, 244, 0.35);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CalibrationPanel" style="flex-grow: 1;">
                <ui:VisualElement name="Screen" style="flex-grow: 0; margin-bottom: 10px; background-color: rgb(8, 12, 16); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-top: 18px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; border-left-color: rgba(244, 244, 244, 0.07); border-right-color: rgba(244, 244, 244, 0.07); border-top-color: rgba(244, 244, 244, 0.07); border-bottom-color: rgba(244, 244, 244, 0.07); width: 450px; margin-top: 25px; height: 230px;">
                    <ui:VisualElement name="Heading" style="flex-grow: 0; flex-direction: row; margin-bottom: 14px; align-items: center;">
                        <ui:VisualElement name="Title" style="flex-grow: 0.66666; flex-direction: row; justify-content: flex-start; align-items: center; padding-bottom: 11px; padding-top: 11px;">
                            <ui:Image source="project://database/Assets/Images/Icons/info.svg?fileID=7388822144124034973&amp;guid=b0ab8afa761dd4c48b0e2a536421d082&amp;type=3#info" tint-color="rgba(244, 244, 244, 0.35)" style="width: 18px; height: 18px; margin-right: 6px;"/>
                            <ui:Label text="CALIBRATION" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Medium.ttf?fileID=12800000&amp;guid=4502073703758934880cc373e6200123&amp;type=3#BarlowCondensed-Medium&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 18px; letter-spacing: 10px; color: rgba(244, 244, 244, 0.35);"/>
                        </ui:VisualElement>
                        <ui:Button text="" name="UndoButton" style="border-left-color: rgba(244, 244, 244, 0.1); border-right-color: rgba(244, 244, 244, 0.1); border-top-color: rgba(244, 244, 244, 0.1); border-bottom-color: rgba(244, 244, 244, 0.1); background-color: rgb(8, 12, 16); flex-direction: row; -unity-text-align: middle-center; align-self: center; align-items: center; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-grow: 0.33; justify-content: center; display: none;">
                            <ui:Image source="project://database/Assets/Images/Icons/chevron-left.svg?fileID=7388822144124034973&amp;guid=c853323738d9a5348a55da2827360834&amp;type=3#chevron-left" tint-color="rgba(244, 244, 244, 0.6)" scale-mode="ScaleToFit" style="width: 16px; height: 16px; margin-right: 8px;"/>
                            <ui:Label text="UNDO" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); color: rgba(244, 244, 244, 0.6); font-size: 18px; height: auto; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="Separator" style="flex-grow: 0; margin-bottom: 16px; height: 3px; background-color: rgba(244, 244, 244, 0.1); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; background-size: 100px 100%; width: 100%;"/>
                    <ui:VisualElement name="StructuralNode" style="flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement name="Instruction" style="flex-grow: 0;">
                            <ui:Label text="READY TO CALIBRATE" name="Heading" style="margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px; color: rgb(244, 244, 244); -unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;);"/>
                            <ui:Label text="Calibration maps your physical controller&apos;s axis range so the simulator receives accurate inputs. Press Start Calibration to begin the 2-step process.&#10;" name="Description" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Medium.ttf?fileID=12800000&amp;guid=65017560903cc07408d38222365f499f&amp;type=3#Barlow-Medium&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgba(244, 244, 244, 0.35); white-space: normal; font-size: 18px; display: flex;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="InvertButtons" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; display: flex; align-self: stretch; margin-left: 0; width: auto;">
                            <ui:Button text="&#10;" name="YesButton" style="border-left-color: rgba(244, 244, 244, 0.1); border-right-color: rgba(244, 244, 244, 0.1); border-top-color: rgba(244, 244, 244, 0.1); border-bottom-color: rgba(244, 244, 244, 0.1); background-color: rgb(8, 12, 16); flex-direction: row; -unity-text-align: middle-center; align-self: center; align-items: center; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-grow: 1; justify-content: center; display: none; width: auto;">
                                <ui:Image source="project://database/Assets/Images/Icons/check.svg?fileID=7388822144124034973&amp;guid=17b3a63189671c84c82acc4a24ff543d&amp;type=3#check" tint-color="rgba(244, 244, 244, 0.6)" scale-mode="ScaleToFit" style="width: 16px; height: 16px; margin-right: 8px;"/>
                                <ui:Label text="YES" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); color: rgba(244, 244, 244, 0.6); font-size: 18px; height: 16px; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                            </ui:Button>
                            <ui:Button text="" name="NoButton" style="border-left-color: rgba(244, 244, 244, 0.1); border-right-color: rgba(244, 244, 244, 0.1); border-top-color: rgba(244, 244, 244, 0.1); border-bottom-color: rgba(244, 244, 244, 0.1); background-color: rgb(8, 12, 16); flex-direction: row; -unity-text-align: middle-center; align-self: center; align-items: center; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-grow: 1; justify-content: center; display: none; width: auto; font-size: 18px;">
                                <ui:Image source="project://database/Assets/Images/Icons/x.svg?fileID=7388822144124034973&amp;guid=134984d4faa98b549bb9502fb96872f1&amp;type=3#x" tint-color="rgba(244, 244, 244, 0.6)" scale-mode="ScaleToFit" style="width: 16px; height: 16px; margin-right: 8px;"/>
                                <ui:Label text="NO" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); color: rgba(244, 244, 244, 0.6); font-size: 18px; height: 16px; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="StructuralNode" style="flex-grow: 0; margin-right: 0; flex-direction: row; align-items: stretch; justify-content: space-between;">
                    <ui:Button text="START CALIBRATION" name="StartCalibrationButton" style="margin-top: 0; margin-right: 5px; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; height: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); background-color: rgb(76, 171, 54); border-left-color: rgb(76, 171, 54); border-right-color: rgb(76, 171, 54); border-top-color: rgb(76, 171, 54); border-bottom-color: rgb(76, 171, 54); width: auto; aspect-ratio: auto; flex-grow: 0.5; font-size: 18px; align-content: auto; align-self: auto; justify-content: flex-start; align-items: auto;"/>
                    <ui:Button text="" name="SaveButton" class="disabled" style="border-left-color: rgba(76, 171, 54, 0.4); border-right-color: rgba(76, 171, 54, 0.4); border-top-color: rgba(76, 171, 54, 0.4); border-bottom-color: rgba(76, 171, 54, 0.4); background-color: rgba(76, 171, 54, 0.2); flex-direction: row; -unity-text-align: middle-center; align-self: center; align-items: center; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; flex-grow: 1; justify-content: center;">
                        <ui:Image source="project://database/Assets/Images/Icons/save.svg?fileID=7388822144124034973&amp;guid=151eb19213b785746a6b9aa56f037917&amp;type=3#save" tint-color="rgb(76, 171, 54)" scale-mode="ScaleToFit" style="width: 16px; height: 16px; margin-right: 8px;"/>
                        <ui:Label text="SAVE" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); color: rgb(76, 171, 54); font-size: 18px; height: auto; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
