<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="DroneCard" src="project://database/Assets/UI/Components/DroneCard.uxml?fileID=9197481963319205126&amp;guid=76143e1036a382e48893b4ab3f933429&amp;type=3#DroneCard"/>
    <Style src="project://database/Assets/UI/SettingsMenus/drone-menu.uss?fileID=7433441132597879392&amp;guid=16bbcbcba8982ef4cbef7fd8dff24cf6&amp;type=3#drone-menu"/>
    <Style src="project://database/Assets/UI/SettingsMenus/menus.uss?fileID=7433441132597879392&amp;guid=826f0cfa17333524e96e4e1e621676bc&amp;type=3#menus"/>
    <Style src="project://database/Assets/UI/Components/numerical-fileds.uss?fileID=7433441132597879392&amp;guid=21c13465f3d5e344e95b1b86b2e0cfca&amp;type=3#numerical-fileds"/>
    <ui:VisualElement name="Parent" style="flex-grow: 0; flex-direction: row; align-items: stretch; width: 100%; height: 100%; justify-content: space-between; padding-top: 32px; padding-right: 40px; padding-bottom: 32px; padding-left: 40px;">
        <ui:VisualElement name="StructuralNode" style="flex-grow: 0; align-self: flex-start;">
            <ui:VisualElement name="Configuration" class="floating-window" style="flex-grow: 0; align-self: stretch;">
                <ui:Label text="Configuration" name="Header"/>
                <ui:VisualElement name="Content" style="flex-grow: 1;">
                    <ui:VisualElement name="DroneNameRow" class="row" style="flex-grow: 1;">
                        <ui:TextField label="Drone Name" placeholder-text="filler text" name="DroneName" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ProppellerSizeRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Propeller Size"/>
                        <ui:VisualElement name="Options" style="flex-grow: 1; flex-direction: row;">
                            <ui:Button text="2&quot;"/>
                            <ui:Button text="2.5&quot;"/>
                            <ui:Button text="3&quot;&#10;"/>
                            <ui:Button text="4&quot;&#10;" style="background-color: rgb(76, 171, 54); border-left-color: rgb(76, 171, 54); border-right-color: rgb(76, 171, 54); border-top-color: rgb(76, 171, 54); border-bottom-color: rgb(76, 171, 54); color: rgb(8, 12, 16);"/>
                            <ui:Button text="5&quot;"/>
                            <ui:Button text="6&quot;"/>
                            <ui:Button text="7&quot;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="TotalWeightRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Total Weight"/>
                        <FloatField name="TotalWeight" max="100000" style="color: rgb(76, 171, 54);"/>
                        <ui:Label text="(g) grams" style="width: auto; font-size: 13px; color: rgb(76, 171, 54);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="FrameSizeRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Frame Size"/>
                        <IntegerField name="FrameSize" max="100000" style="color: rgb(74, 159, 212);"/>
                        <ui:Label text="(mm) milimeters" style="width: auto; font-size: 13px; color: rgb(74, 159, 212);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="BatteryCapacityRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Battery Capacity"/>
                        <IntegerField name="BatteryCapacity" max="100000" style="margin-top: 0; margin-bottom: 0; color: rgb(212, 164, 74);"/>
                        <ui:Label text="(Ah) ampere-hour" style="width: auto; font-size: 13px; color: rgb(212, 164, 74); -unity-text-align: upper-left;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MotorThrustRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Thrust per Motor"/>
                        <FloatField name="MotorThrust" max="100000" style="color: rgba(244, 244, 244, 0.23);"/>
                        <ui:Label text="(gf) gram-force" style="width: auto; font-size: 13px; color: rgba(244, 244, 244, 0.23);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MotorTorqueConstantRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Motor Torque Constant"/>
                        <FloatField name="MotorTorqueConstant" max="100000" style="color: rgba(244, 244, 244, 0.23);"/>
                        <ui:Label text="&#10;" style="width: auto; font-size: 13px; color: rgba(244, 244, 244, 0.23);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="CameraAngleRow" class="row" style="flex-grow: 1; flex-direction: row;">
                        <ui:SliderInt label="Camera Angle" value="35" high-value="90" name="CameraAngle" style="flex-grow: 1;"/>
                        <ui:Label text="35`" name="CameraAngleLabel" style="font-size: 13px; color: rgb(76, 171, 54); width: 50px; -unity-text-align: upper-center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Performance" class="floating-window" style="flex-grow: 0; align-self: stretch;">
                <ui:Label text="Performance Estimates" name="Header"/>
                <ui:VisualElement name="Content" style="flex-grow: 1; flex-direction: row; padding-top: 14px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px; font-size: 18px; justify-content: space-around;">
                    <ui:VisualElement name="TWR" class="statbox" style="flex-grow: 1; margin-right: 10px; align-self: stretch; justify-content: flex-start; align-items: stretch;">
                        <ui:Label text="THRUST-TO-WEIGHT" name="Title" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:VisualElement name="StructuralNode" style="flex-grow: 1;">
                            <ui:Label text="15.71" name="Value" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; letter-spacing: 0; color: rgb(76, 171, 54);"/>
                            <ui:Label text="TWR" name="Unit" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="HoverThrottle" class="statbox" style="flex-grow: 1; margin-right: 10px; align-self: stretch;">
                        <ui:Label text="HOVER THROTTLE" name="Title" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:VisualElement name="StructuralNode" style="flex-grow: 1;">
                            <ui:Label text="6" name="Value" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(74, 159, 212);"/>
                            <ui:Label text="%" name="Unit"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="TotalThrust" class="statbox" style="flex-grow: 1; margin-right: 10px; align-self: stretch;">
                        <ui:Label text="TOTAL THRUST" name="Title" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:VisualElement name="StructuralNode" style="flex-grow: 1;">
                            <ui:Label text="4.40" name="Value" style="-unity-text-align: middle-right; align-self: auto; align-content: auto; color: rgb(212, 164, 74);"/>
                            <ui:Label text="kg" name="Unit"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="MaxSpeed" class="statbox" style="flex-grow: 1; margin-right: 0; align-self: stretch;">
                        <ui:Label text=" MAX SPEED" name="Title" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:VisualElement name="StructuralNode" style="flex-grow: 1;">
                            <ui:Label text="43" name="Value" style="color: rgb(76, 171, 54);"/>
                            <ui:Label text="m/s" name="Unit"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="DroneLibrary" class="floating-window" style="flex-grow: 0; align-self: flex-start; margin-bottom: 32px; flex-wrap: nowrap; overflow: visible; visibility: visible; flex-direction: column; width: auto;">
            <ui:Label text="Drone Library" name="Header"/>
            <ui:ScrollView name="Content" touch-scroll-type="Clamped" mode="Vertical" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="18" style="width: auto; height: auto; flex-wrap: wrap; overflow: hidden;">
                <ui:VisualElement name="AddButton" class="drone-card" style="flex-grow: 0; justify-content: center;">
                    <ui:Image source="project://database/Assets/Images/Icons/plus.svg?fileID=7388822144124034973&amp;guid=a42904a70ae8e5b4295d7db0040ff5a7&amp;type=3#plus" name="Image" tint-color="rgba(244, 244, 244, 0.7)" style="width: 60px; height: 60px; align-content: center; align-self: center;"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
