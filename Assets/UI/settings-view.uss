:root {
}

.settings-menu-tab {
    flex-direction: row;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(8, 12, 16);
    color: rgb(255, 255, 255);
}

.settings-menu-tab .button-icon {
    --unity-image-tint-color: rgb(75, 75, 75);
}

.settings-menu-tab:hover {
    background-color: rgb(33, 37, 42);
    transition-duration: 0.35s;
    cursor: url("project://database/Assets/Images/Icons/pointer.png?fileID=2800000&guid=657f29b1ddd74404783384063bd707a2&type=3#pointer");
    border-left-color: rgba(76, 171, 54, 0.35);
    border-right-color: rgba(76, 171, 54, 0.35);
    border-top-color: rgba(76, 171, 54, 0.35);
    border-bottom-color: rgba(76, 171, 54, 0.35);
}

.settings-menu-tab:hover .button-icon {
    --unity-image-tint-color: rgb(76, 171, 54);
}

.active {
    flex-direction: row;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(0, 0, 0);
    background-color: #4cab36;
}

.active .button-icon {
    --unity-image-tint-color: rgb(0, 0, 0);
}
