<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/main-menu-ui.uss?fileID=7433441132597879392&amp;guid=209e76e44b092e841a05253943bca5a4&amp;type=3#main-menu-ui"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(8, 12, 16, 0.83);">
        <ui:VisualElement name="PauseMenu" style="flex-grow: 1; width: 540px; padding-left: 0; padding-right: 0; margin-left: 0; color: rgb(255, 255, 255); justify-content: center; height: 100%; align-items: center; align-self: center;">
            <ui:Label text="PAUSE MENU&#10;" name="PauseMenuLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 16px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Black.ttf?fileID=12800000&amp;guid=1644c8f8a32e548498832b745a3602d0&amp;type=3#BarlowCondensed-Black&quot;);"/>
            <ui:Button text="" name="ResumeFlightButton" enabled="true" tooltip="" class="main-menu-button" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; background-color: rgb(76, 171, 54); -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                    <ui:Image source="project://database/Assets/Images/Icons/play.svg?fileID=7388822144124034973&amp;guid=14ade0ebdeabaae4481e40f180a594b5&amp;type=3#play" tint-color="rgb(8, 12, 16)" name="Image" picking-mode="Ignore" class="button-icon" style="width: 22px; margin-right: 18px; padding-right: 0; height: 18px; align-self: center;"/>
                    <ui:Label text="RESUME FLIGHT" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); font-size: 17px; letter-spacing: 10px; color: rgb(8, 12, 16);"/>
                </ui:VisualElement>
                <ui:Image name="Image" source="project://database/Assets/Images/Icons/chevron-right.svg?fileID=7388822144124034973&amp;guid=030931756de5efe4f81d39bae40362a5&amp;type=3#chevron-right" tint-color="rgb(8, 12, 16)" picking-mode="Ignore"/>
            </ui:Button>
            <ui:Button text="" name="RCControllerButton" class="main-menu-button" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                    <ui:Image source="project://database/Assets/Images/Icons/gamepad.svg?fileID=7388822144124034973&amp;guid=721c78076682d8040924f4e8304c1753&amp;type=3#gamepad" picking-mode="Ignore" class="button-icon" style="width: auto; margin-right: 18px; padding-right: 0; height: 18px; align-self: center;"/>
                    <ui:Label text="CONTROLLER CONFIGURATION" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); font-size: 17px; letter-spacing: 10px; color: rgb(244, 244, 244);"/>
                </ui:VisualElement>
                <ui:Image name="Image" source="project://database/Assets/Images/Icons/chevron-right.svg?fileID=7388822144124034973&amp;guid=030931756de5efe4f81d39bae40362a5&amp;type=3#chevron-right" picking-mode="Ignore" class="chevron"/>
            </ui:Button>
            <ui:Button text="" name="DroneButton" class="main-menu-button" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                    <ui:Image source="project://database/Assets/Images/DroneIcon.svg?fileID=7388822144124034973&amp;guid=dfed4a4b8c715994bbddcac32dfe34f3&amp;type=3#DroneIcon" picking-mode="Ignore" class="button-icon" style="width: 22px; margin-right: 18px; padding-right: 0; height: 18px; align-self: center;"/>
                    <ui:Label text="DRONE CONFIGURATION" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); font-size: 17px; letter-spacing: 10px; color: rgb(244, 244, 244);"/>
                </ui:VisualElement>
