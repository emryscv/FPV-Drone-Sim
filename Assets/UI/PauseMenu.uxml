            </ui:Button>
            <ui:Button text="" name="SettingsButton" class="main-menu-button" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
