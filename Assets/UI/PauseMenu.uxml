                    <ui:Label text="SETTINGS" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); font-size: 17px; letter-spacing: 10px; color: rgb(244, 244, 244); -unity-text-align: middle-center; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start;"/>
                </ui:VisualElement>
                <ui:Image name="Image" source="project://database/Assets/Images/Icons/chevron-right.svg?fileID=7388822144124034973&amp;guid=030931756de5efe4f81d39bae40362a5&amp;type=3#chevron-right" picking-mode="Ignore" class="chevron" style="height: auto; align-self: center;"/>
            </ui:Button>
            <ui:Button text="" name="ExitButton" class="main-menu-button" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                    <ui:Image source="project://database/Assets/Images/Icons/log-out.svg?fileID=7388822144124034973&amp;guid=c4b2f09280c9a6a40aa6b15cecccada2&amp;type=3#log-out" picking-mode="Ignore" class="button-icon" style="width: auto; margin-right: 18px; padding-right: 0; height: 18px; align-self: center;"/>
                    <ui:Label text="EXIT" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/BarlowCondensed/BarlowCondensed-Bold.ttf?fileID=12800000&amp;guid=5f7b0a079acd8ec449b1459679e8abbf&amp;type=3#BarlowCondensed-Bold&quot;); font-size: 17px; letter-spacing: 10px; color: rgb(244, 244, 244);"/>
                </ui:VisualElement>
                <ui:Image name="Image" source="project://database/Assets/Images/Icons/chevron-right.svg?fileID=7388822144124034973&amp;guid=030931756de5efe4f81d39bae40362a5&amp;type=3#chevron-right" picking-mode="Ignore" class="chevron"/>
