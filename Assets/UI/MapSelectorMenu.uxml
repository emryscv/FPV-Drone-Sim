    <ui:VisualElement name="Header" style="flex-grow: 0; flex-direction: row; border-bottom-width: 1px; border-left-color: rgba(244, 244, 244, 0.06); border-right-color: rgba(244, 244, 244, 0.06); border-top-color: rgba(244, 244, 244, 0.06); border-bottom-color: rgba(244, 244, 244, 0.06); padding-top: 20px; padding-right: 36px; padding-bottom: 20px; padding-left: 36px; background-color: rgb(8, 12, 16);">
