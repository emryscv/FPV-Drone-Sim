:root {
}

.main-menu-button {
    height: 64px;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
    flex-direction: row;
    background-color: rgb(15, 19, 23);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-left-color: rgba(244, 244, 244, 0.07);
    border-right-color: rgba(244, 244, 244, 0.07);
    border-top-color: rgba(244, 244, 244, 0.07);
    border-bottom-color: rgba(244, 244, 244, 0.07);
    color: rgb(255, 255, 255);
    cursor: url("project://database/Assets/Images/pointer.png?fileID=2800000&guid=657f29b1ddd74404783384063bd707a2&type=3#pointer");
}

.main-menu-button:hover {
    background-color: rgb(33, 37, 42);
}
